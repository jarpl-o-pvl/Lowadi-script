// ==UserScript==
// @name         Lowadi: Панель автопрогона и кача v4
// @namespace    http://tampermonkey.net/
// @version      4.0
// @description  Умный поиск кнопок, ожидание обновления DOM, защита от повторных кликов
// @author       YourName
// @match        *://*.lowadi.com/*
// @match        *://*.lowadi.fr/*
// @grant        GM_setValue
// @grant        GM_getValue
// @grant        GM_addStyle
// ==/UserScript==

(function () {
    'use strict';

    // ================= НАСТРОЙКИ =================
    const CONFIG = {
        defaultDelay: 1500,
        maxIterations: 100,
        maxFailedIterations: 6,   // сколько итераций подряд "ничего не нашли" — стоп
        domWaitTimeout: 2500,     // сколько ждать реакции страницы после клика
        clickCooldown: 400,       // пауза после клика, чтобы страница не "проглотила" событие

        // ---------- ПРОГОН ----------
        runActions: [
            { name: 'Кормление',  keywords: ['покормить', 'кормить', 'feed', 'nourrir', 'manger'], optional: true },
            { name: 'Поить',      keywords: ['напоить', 'поить', 'abreuver', 'water'], optional: true },
            { name: 'Уход',       keywords: ['почистить', 'чистить', 'уход', 'soigner', 'pansage', 'groom'], optional: true },
            { name: 'Тренировка', keywords: ['тренировать', 'тренировка', 'entrainer', 'entraîner', 'train'], optional: true },
            { name: 'Далее',      keywords: ['следующая', 'далее', 'next', 'suivant'], optional: true }
        ],

        // ---------- КАЧ ----------
        // Каждое действие ищется отдельно. Если не нашли — идём дальше, не залипаем.
        trainActions: [
            // Восстановление
            { name: 'Кормление',   keywords: ['покормить', 'кормить', 'feed', 'nourrir', 'manger'], optional: true },
            { name: 'Поить',       keywords: ['напоить', 'поить', 'abreuver', 'water'], optional: true },
            { name: 'Чистка',      keywords: ['почистить', 'чистить', 'soigner', 'pansage', 'groom'], optional: true },
            { name: 'Морковь',     keywords: ['морковь', 'carotte', 'carrot'], optional: true },
            { name: 'Сахар',       keywords: ['сахар', 'sucre', 'sugar'], optional: true },

            // Тренировки — самые разные варианты подписей
            { name: 'Тренировка: Скорость',       keywords: ['скорость', 'speed', 'vitesse'], optional: true },
            { name: 'Тренировка: Выездка',        keywords: ['выездка', 'dressage'], optional: true },
            { name: 'Тренировка: Прыжки',         keywords: ['прыжк', 'saut', 'jump'], optional: true },
            { name: 'Тренировка: Выносливость',   keywords: ['выносливост', 'endurance'], optional: true },
            { name: 'Тренировка: Галоп',          keywords: ['галоп', 'galop', 'gallop'], optional: true },

            // Прогулки
            { name: 'Прогулка',    keywords: ['прогулк', 'promenade', 'walk'], optional: true },

            // Сон
            { name: 'Сон',         keywords: ['спать', 'сон', 'уложить', 'dormir', 'sleep'], optional: true }
        ]
    };

    // ================= СОСТОЯНИЕ =================
    let isRunning = false;
    let iterationCount = 0;
    let failedStreak = 0;
    let currentDelay = GM_getValue('lowadiDelay', CONFIG.defaultDelay);
    let currentMode = GM_getValue('lowadiMode', 'run');

    // Элементы, по которым уже кликнули (в рамках одной итерации) — защита от повторного клика
    let clickedThisIteration = new WeakSet();

    // ================= ПАНЕЛЬ =================
    const panel = document.createElement('div');
    panel.id = 'lowadi-panel';
    panel.innerHTML = `
        <div class="lp-header">
            <span>Lowadi Панель v4</span>
            <button id="lp-minimize" title="Свернуть">—</button>
        </div>
        <div class="lp-body">
            <div class="lp-mode">
                <label><input type="radio" name="lp-mode" value="run" ${currentMode === 'run' ? 'checked' : ''}> Прогон</label>
                <label><input type="radio" name="lp-mode" value="train" ${currentMode === 'train' ? 'checked' : ''}> Кач</label>
            </div>
            <div class="lp-status">Статус: <span id="lp-status-text">Ожидание</span></div>
            <div class="lp-controls">
                <button id="lp-start">▶ Старт</button>
                <button id="lp-stop" disabled>■ Стоп</button>
            </div>
            <div class="lp-setting">
                <label>Задержка (мс): <input type="number" id="lp-delay" value="${currentDelay}" min="500" step="100"></label>
            </div>
            <div class="lp-log" id="lp-log"></div>
        </div>
    `;
    document.body.appendChild(panel);

    GM_addStyle(`
        #lowadi-panel{position:fixed;top:10px;right:10px;width:300px;background:#1e1e2f;color:#e0e0e0;border:1px solid #444;border-radius:8px;font-family:'Segoe UI',Arial,sans-serif;font-size:13px;z-index:99999;box-shadow:0 4px 15px rgba(0,0,0,.5);user-select:none}
        .lp-header{display:flex;justify-content:space-between;align-items:center;padding:8px 12px;background:#2a2a40;border-radius:8px 8px 0 0;cursor:move;font-weight:bold}
        .lp-header button{background:none;border:none;color:#aaa;font-size:16px;cursor:pointer}
        .lp-body{padding:10px}
        .lp-mode{display:flex;gap:15px;margin-bottom:8px;padding:5px;background:#25253a;border-radius:4px}
        .lp-mode label{cursor:pointer;font-weight:bold}
        .lp-status{margin-bottom:8px}
        #lp-status-text{font-weight:bold;color:#ffcc00}
        .lp-controls{display:flex;gap:8px;margin-bottom:10px}
        .lp-controls button{flex:1;padding:5px;border:none;border-radius:4px;cursor:pointer;font-weight:bold}
        #lp-start{background:#2e7d32;color:#fff}
        #lp-start:disabled{background:#444;color:#888;cursor:not-allowed}
        #lp-stop{background:#c62828;color:#fff}
        #lp-stop:disabled{background:#444;color:#888;cursor:not-allowed}
        .lp-setting{margin-bottom:10px}
        .lp-setting input{width:70px;background:#333;border:1px solid #555;color:#fff;padding:2px 5px;border-radius:3px}
        .lp-log{height:110px;overflow-y:auto;background:#111;border:1px solid #333;padding:5px;font-family:monospace;font-size:11px;color:#0f0;border-radius:3px}
    `);

    const statusText = document.getElementById('lp-status-text');
    const startBtn = document.getElementById('lp-start');
    const stopBtn = document.getElementById('lp-stop');
    const delayInput = document.getElementById('lp-delay');
    const logContainer = document.getElementById('lp-log');

    document.querySelectorAll('input[name="lp-mode"]').forEach(radio => {
        radio.addEventListener('change', (e) => {
            if (isRunning) {
                e.target.checked = false;
                document.querySelector(`input[name="lp-mode"][value="${currentMode}"]`).checked = true;
                log('Сначала остановите выполнение.');
                return;
            }
            currentMode = e.target.value;
            GM_setValue('lowadiMode', currentMode);
            log(`Режим: ${currentMode === 'run' ? 'Прогон' : 'Кач'}`);
        });
    });

    // Перетаскивание
    const header = panel.querySelector('.lp-header');
    let isDragging = false, offsetX = 0, offsetY = 0;
    header.addEventListener('mousedown', (e) => {
        isDragging = true;
        offsetX = e.clientX - panel.offsetLeft;
        offsetY = e.clientY - panel.offsetTop;
    });
    document.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        panel.style.left = (e.clientX - offsetX) + 'px';
        panel.style.top = (e.clientY - offsetY) + 'px';
        panel.style.right = 'auto';
    });
    document.addEventListener('mouseup', () => { isDragging = false; });

    document.getElementById('lp-minimize').addEventListener('click', () => {
        const body = panel.querySelector('.lp-body');
        body.style.display = body.style.display === 'none' ? 'block' : 'none';
    });

    // ================= ЛОГИ =================
    function log(message) {
        const entry = document.createElement('div');
        entry.textContent = `[${new Date().toLocaleTimeString()}] ${message}`;
        logContainer.appendChild(entry);
        logContainer.scrollTop = logContainer.scrollHeight;
    }
    function setStatus(text) { statusText.textContent = text; }
    function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

    // ================= УТИЛИТЫ =================
    function normalizeText(text) {
        return String(text || '')
            .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
            .replace(/\s+/g, ' ').trim().toLowerCase();
    }

    function collectDocuments(rootDoc = document, result = [], depth = 0) {
        if (depth > 2) return result;
        result.push(rootDoc);
        let iframes;
        try { iframes = rootDoc.querySelectorAll('iframe'); } catch (e) { return result; }
        for (const iframe of iframes) {
            try {
                const doc = iframe.contentDocument;
                if (doc && !result.includes(doc)) collectDocuments(doc, result, depth + 1);
            } catch (e) {}
        }
        return result;
    }

    function isDisabled(el) {
        if (!el) return true;
        if (el.disabled) return true;
        if (el.getAttribute && el.getAttribute('aria-disabled') === 'true') return true;
        try { if (el.matches && el.matches(':disabled')) return true; } catch (e) {}
        if (el.classList && (el.classList.contains('disabled') || el.classList.contains('is-disabled'))) return true;
        // родитель <a>/<button> может быть disabled-обёрткой
        const parent = el.closest && el.closest('button, a, [role="button"], .btn');
        if (parent && parent !== el && (parent.disabled || (parent.classList && (parent.classList.contains('disabled') || parent.classList.contains('is-disabled'))))) {
            return true;
        }
        return false;
    }

    function isVisible(el) {
        if (!el) return false;
        if (el.closest && el.closest('#lowadi-panel')) return false;
        const doc = el.ownerDocument;
        const win = doc.defaultView || window;
        try {
            const style = win.getComputedStyle(el);
            if (style.display === 'none' || style.visibility === 'hidden' || style.opacity === '0') return false;
            if (style.pointerEvents === 'none') return false;
        } catch (e) {}
        const rect = el.getBoundingClientRect();
        return rect.width > 1 && rect.height > 1;
    }

    function getSearchText(el) {
        const attrs = ['aria-label', 'title', 'alt', 'data-tooltip', 'data-original-title', 'name', 'value'];
        let text = el.textContent || '';
        if (el.value) text += ' ' + el.value;
        for (const attr of attrs) {
            const v = el.getAttribute && el.getAttribute(attr);
            if (v) text += ' ' + v;
        }
        if (el.querySelectorAll) {
            el.querySelectorAll('img[alt], img[title]').forEach(img => {
                text += ' ' + (img.alt || '') + ' ' + (img.title || '');
            });
        }
        return normalizeText(text);
    }

    // Возвращает массив {el, score}. Чем выше score — тем вероятнее это нужная кнопка.
    function findCandidates(keywords) {
        const normKeywords = keywords.map(normalizeText).filter(Boolean);
        const docs = collectDocuments();
        const selector = 'button, a, input[type="submit"], input[type="button"], input[type="image"], [role="button"], .btn, img[alt], img[title], [onclick]';
        const candidates = [];
        const seen = new Set();

        for (const doc of docs) {
            let elements;
            try { elements = doc.querySelectorAll(selector); } catch (e) { continue; }

            for (const rawEl of elements) {
                let el = rawEl;
                // Если картинка — цепляемся к родительской кнопке/ссылке
                if (el.tagName === 'IMG') {
                    el = el.closest('a, button, [role="button"], [onclick], .btn') || el;
                }
                if (!el || seen.has(el)) continue;
                seen.add(el);

                if (!isVisible(el)) continue;
                if (isDisabled(el)) continue;
                if (clickedThisIteration.has(el)) continue;

                const text = getSearchText(el);
                if (!text) continue;

                // Определяем score
                const tag = el.tagName.toLowerCase();
                const isClickable = ['button','a'].includes(tag) || el.getAttribute('role') === 'button' || (el.classList && el.classList.contains('btn')) || el.hasAttribute('onclick');
                const textLen = text.length;

                let best = 0;
                for (const kw of normKeywords) {
                    if (!kw) continue;
                    // точное совпадение всего текста
                    if (text === kw) best = Math.max(best, 100);
                    // начинается с kw и короткий текст (кнопка)
                    else if (text.startsWith(kw) && textLen < 60 && isClickable) best = Math.max(best, 85);
                    // содержит kw и короткий кликабельный текст
                    else if (text.includes(kw) && textLen < 60 && isClickable) best = Math.max(best, 70);
                    // содержит kw и кликабельный, но длинный текст
                    else if (text.includes(kw) && isClickable) best = Math.max(best, 50);
                    // содержит kw, но не кликабельный элемент — низкий приоритет
                    else if (text.includes(kw)) best = Math.max(best, 20);
                }
                if (best > 0) candidates.push({ el, score: best, text: text.slice(0, 60) });
            }
        }

        candidates.sort((a, b) => b.score - a.score);
        return candidates;
    }

    // Ждём, пока DOM "отреагирует" на клик: изменится количество видимых кнопок
    // или истечёт таймаут.
    async function waitForDomChange(timeout) {
        const t0 = performance.now();
        const initial = document.querySelectorAll('button, a, [role="button"], .btn').length;
        while (performance.now() - t0 < timeout) {
            await sleep(100);
            const current = document.querySelectorAll('button, a, [role="button"], .btn').length;
            if (current !== initial) return true;
        }
        return false;
    }

    function dispatchClick(el) {
        try { el.scrollIntoView({ block: 'center', behavior: 'instant' }); } catch (e) {}
        try {
            el.click();
        } catch (e) {
            const win = el.ownerDocument.defaultView || window;
            el.dispatchEvent(new win.MouseEvent('click', { bubbles: true, cancelable: true, view: win }));
        }
    }

    async function tryAction(action) {
        if (!isRunning) return false;
        const candidates = findCandidates(action.keywords);
        if (candidates.length === 0) return false;

        const chosen = candidates[0];
        if (chosen.score < 40) {
            log(`«${action.name}»: найдено только слабое совпадение (${chosen.score}), пропуск`);
            return false;
        }

        log(`Клик: ${action.name} → "${chosen.text}" (score ${chosen.score})`);
        clickedThisIteration.add(chosen.el);
        dispatchClick(chosen.el);

        await sleep(CONFIG.clickCooldown);
        await waitForDomChange(CONFIG.domWaitTimeout);
        await sleep(currentDelay);
        return true;
    }

    // ================= ИТЕРАЦИЯ =================
    async function performIteration() {
        if (!isRunning) return 'stop';
        if (iterationCount >= CONFIG.maxIterations) {
            log('Достигнут лимит итераций. Остановка.');
            return 'stop';
        }

        iterationCount++;
        clickedThisIteration = new WeakSet();

        const modeName = currentMode === 'run' ? 'ПРОГОН' : 'КАЧ';
        log(`--- ${modeName} #${iterationCount} ---`);

        const actions = currentMode === 'run' ? CONFIG.runActions : CONFIG.trainActions;
        let clickedAny = false;

        for (const action of actions) {
            if (!isRunning) return 'stop';
            const ok = await tryAction(action);
            if (ok) clickedAny = true;
        }

        if (!clickedAny) {
            failedStreak++;
            log(`Ничего не найдено (подряд: ${failedStreak}/${CONFIG.maxFailedIterations})`);
            if (failedStreak >= CONFIG.maxFailedIterations) {
                log('Слишком много промахов подряд — остановка.');
                return 'stop';
            }
            await sleep(currentDelay);
            return 'retry';
        }

        failedStreak = 0;
        return 'continue';
    }

    async function runLoop() {
        iterationCount = 0;
        failedStreak = 0;

        while (isRunning) {
            const result = await performIteration();
            if (result === 'stop') break;
            await sleep(200);
        }

        if (isRunning) {
            isRunning = false;
            updateButtons();
            setStatus('Завершено');
        }
    }

    function updateButtons() {
        startBtn.disabled = isRunning;
        stopBtn.disabled = !isRunning;
        if (isRunning) setStatus(`Выполняется (${currentMode === 'run' ? 'прогон' : 'кач'})...`);
        else if (statusText.textContent.includes('Выполняется')) setStatus('Остановлено');
    }

    startBtn.addEventListener('click', () => {
        if (isRunning) return;
        document.querySelectorAll('input[name="lp-mode"]').forEach(r => r.disabled = true);
        isRunning = true;
        updateButtons();
        log(`Запуск: ${currentMode === 'run' ? 'ПРОГОН' : 'КАЧ'}`);
        runLoop();
    });

    stopBtn.addEventListener('click', () => {
        isRunning = false;
        document.querySelectorAll('input[name="lp-mode"]').forEach(r => r.disabled = false);
        updateButtons();
        log('Остановлено пользователем.');
    });

    delayInput.addEventListener('change', (e) => {
        let v = parseInt(e.target.value, 10);
        if (isNaN(v) || v < 300) v = 300;
        currentDelay = v;
        e.target.value = v;
        GM_setValue('lowadiDelay', v);
        log(`Задержка: ${v} мс`);
    });

    log('Панель v4 загружена. Умный поиск + защита от повторных кликов.');
    setStatus('Готов');
})();
