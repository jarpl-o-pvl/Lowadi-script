// ==UserScript==
// @name         Lowadi v43 (Beautiful UI & Run Mode)
// @namespace    http://tampermonkey.net/
// @version      43.0
// @description  Красивый интерфейс, режимы Кач и Прогон, ввод корма/овса
// @author       YourName
// @match        *://*.lowadi.com/*
// @match        *://*.howrse.com/*
// @grant        GM_setValue
// @grant        GM_getValue
// @grant        GM_addStyle
// @run-at       document-idle
// ==/UserScript==

(function () {
    'use strict';

    const ACTIONS_PRE = [
        { id: 'water', name: 'Поить', kw: ['поить', 'напоить', 'water'] },
        { id: 'groom', name: 'Чистить', kw: ['чистить', 'почистить', 'groom'] },
        { id: 'carrot', name: 'Морковь', kw: ['морковь', 'carrot'] },
        { id: 'mash', name: 'Смесь', kw: ['смесь', 'mash'] },
        { id: 'pet', name: 'Ласкать', kw: ['ласкать', 'погладить', 'pet'] }
    ];

    const ACTIONS_POST = [
        { id: 'sleep', name: 'Спать', kw: ['спать', 'сон', 'отправить спать'] },
        { id: 'grow', name: 'Вырастить', kw: ['вырастить', 'grow'] }
    ];

    const DEFAULTS = {
        mode: 'train', // 'train' (Кач) или 'run' (Прогон)
        feedAmount: 8,
        oatAmount: 8,
        delayAction: 1500, delayModal: 1000, loopDelay: 3000, isRunning: false,
        enabled: { water: true, groom: true, carrot: true, mash: true, pet: true, sleep: true, grow: true, feed: true, next: true }
    };

    function loadSettings() {
        try {
            const raw = GM_getValue('lowadiSettings_v43', '');
            if (!raw) return JSON.parse(JSON.stringify(DEFAULTS));
            const p = JSON.parse(raw);
            const m = Object.assign({}, DEFAULTS, p);
            m.enabled = Object.assign({}, DEFAULTS.enabled, p.enabled || {});
            return m;
        } catch (e) { return JSON.parse(JSON.stringify(DEFAULTS)); }
    }
    function saveSettings() { GM_setValue('lowadiSettings_v43', JSON.stringify(settings)); }
    let settings = loadSettings();

    let isRunning = settings.isRunning;
    let loopTimeout = null;
    let actionCount = 0;

    // ================= ПАНЕЛЬ =================
    const panel = document.createElement('div');
    panel.id = 'lp-panel';
    panel.innerHTML = `
        <div class="lp-hdr" id="lp-hdr">
            <span class="lp-title">🐴 Lowadi v43</span>
            <button class="lp-icon" id="lp-min">—</button>
        </div>
        <div class="lp-body" id="lp-body">
            <div class="lp-modes">
                <button class="lp-mode-btn" data-mode="train">💪 Кач</button>
                <button class="lp-mode-btn" data-mode="run">🏃 Прогон</button>
            </div>
            <div class="lp-status-bar">
                <div class="lp-status-dot" id="lp-dot"></div>
                <span id="lp-status">Готов</span>
                <button class="lp-main" id="lp-toggle">▶ Старт</button>
            </div>
            <div class="lp-tabs">
                <button class="lp-tab active" id="lp-tab-log">📋 Лог</button>
                <button class="lp-tab" id="lp-tab-settings">⚙ Настройки</button>
            </div>
            <div class="lp-section visible" id="lp-log"></div>
            <div class="lp-section" id="lp-settings"></div>
        </div>
    `;
    document.body.appendChild(panel);

    // ================= СТИЛИ (КРАСИВЫЙ UI) =================
    GM_addStyle(`
        #lp-panel{position:fixed;top:15px;right:15px;width:320px;background:#14141e;color:#e0e0e0;border:1px solid #2a2a3a;border-radius:12px;font-family:'Segoe UI',sans-serif;font-size:12px;z-index:99999;box-shadow:0 8px 30px rgba(0,0,0,.8);user-select:none;overflow:hidden}
        .lp-hdr{display:flex;justify-content:space-between;padding:10px 14px;background:#1c1c28;cursor:move;font-weight:600;font-size:14px;border-bottom:1px solid #2a2a3a}
        .lp-icon{background:none;border:none;color:#888;font-size:18px;cursor:pointer;transition:0.2s}
        .lp-icon:hover{color:#fff}
        .lp-body{padding:12px}
        
        .lp-modes{display:flex;gap:6px;margin-bottom:10px;background:#1c1c28;padding:4px;border-radius:8px}
        .lp-mode-btn{flex:1;background:transparent;border:none;color:#777;padding:8px;font-size:12px;font-weight:600;border-radius:6px;cursor:pointer;transition:0.2s}
        .lp-mode-btn:hover{color:#ccc}
        .lp-mode-btn.active{background:#3a6ea5;color:#fff;box-shadow:0 2px 8px rgba(58,110,165,0.4)}
        
        .lp-status-bar{display:flex;gap:8px;align-items:center;margin-bottom:10px;padding:8px 10px;background:#1c1c28;border-radius:8px;border:1px solid #2a2a3a}
        .lp-status-dot{width:10px;height:10px;border-radius:50%;background:#fbbf24;box-shadow:0 0 8px #fbbf24;transition:0.3s}
        .lp-status-dot.running{background:#10b981;box-shadow:0 0 8px #10b981}
        .lp-status-dot.stopped{background:#ef4444;box-shadow:0 0 8px #ef4444}
        #lp-status{flex:1;font-size:12px;color:#ccc;font-weight:600}
        
        .lp-main{background:#10b981;color:#fff;border:none;padding:8px 16px;border-radius:6px;font-weight:700;cursor:pointer;transition:0.2s;box-shadow:0 2px 8px rgba(16,185,129,0.3)}
        .lp-main:hover{background:#059669}
        .lp-main.running{background:#ef4444;box-shadow:0 2px 8px rgba(239,68,68,0.3)}
        .lp-main.running:hover{background:#dc2626}
        
        .lp-tabs{display:flex;gap:6px;margin-bottom:8px}
        .lp-tab{flex:1;background:#1c1c28;border:1px solid #2a2a3a;color:#777;padding:8px;font-size:11px;border-radius:6px;cursor:pointer;transition:0.2s;font-weight:600}
        .lp-tab:hover{background:#252533;color:#ccc}
        .lp-tab.active{background:#2a2a3a;color:#fff;border-color:#3a6ea5}
        
        .lp-section{display:none;padding:10px;background:#1c1c28;border-radius:8px;max-height:300px;overflow-y:auto;border:1px solid #2a2a3a}
        .lp-section.visible{display:block}
        #lp-log{font-family:monospace;font-size:11px;color:#34d399;line-height:1.5;}
        #lp-log div{border-bottom:1px solid #252533;padding:4px 0}
        
        .s-group{margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid #2a2a3a;}
        .s-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;}
        .s-row span{font-size:12px;color:#ccc;font-weight:600;}
        .s-input{background:#14141e;border:1px solid #3a3a4a;color:#fff;padding:4px 8px;border-radius:4px;width:60px;font-size:12px;outline:none;text-align:center;transition:0.2s}
        .s-input:focus{border-color:#3a6ea5;box-shadow:0 0 5px rgba(58,110,165,0.5)}
        
        .s-check{display:grid;grid-template-columns:1fr 1fr;gap:6px;}
        .s-check label{display:flex;align-items:center;gap:6px;font-size:11px;color:#aaa;cursor:pointer;padding:4px;border-radius:4px;transition:0.2s}
        .s-check label:hover{background:#252533;color:#fff}
        .s-check input{accent-color:#3a6ea5;cursor:pointer;width:14px;height:14px}
    `);

    const logEl = panel.querySelector('#lp-log');
    const settingsEl = panel.querySelector('#lp-settings');
    const toggleBtn = panel.querySelector('#lp-toggle');
    const statusEl = panel.querySelector('#lp-status');
    const statusDot = panel.querySelector('#lp-dot');
    const modeBtns = panel.querySelectorAll('.lp-mode-btn');

    function log(msg) {
        const d = document.createElement('div');
        d.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`;
        logEl.appendChild(d);
        logEl.scrollTop = logEl.scrollHeight;
        while(logEl.childNodes.length > 50) logEl.removeChild(logEl.firstChild);
    }
    const sleep = ms => new Promise(r => setTimeout(r, ms));

    // Переключение режимов
    modeBtns.forEach(btn => {
        if (btn.dataset.mode === settings.mode) btn.classList.add('active');
        btn.onclick = () => {
            if (isRunning) { log('Сначала остановите бота.'); return; }
            settings.mode = btn.dataset.mode;
            saveSettings();
            modeBtns.forEach(b => b.classList.toggle('active', b === btn));
            log(`Режим: ${settings.mode === 'train' ? 'Кач' : 'Прогон'}`);
        };
    });

    panel.querySelector('#lp-tab-log').onclick = () => {
        panel.querySelector('#lp-tab-log').classList.add('active');
        panel.querySelector('#lp-tab-settings').classList.remove('active');
        logEl.classList.add('visible'); settingsEl.classList.remove('visible');
    };
    panel.querySelector('#lp-tab-settings').onclick = () => {
        panel.querySelector('#lp-tab-settings').classList.add('active');
        panel.querySelector('#lp-tab-log').classList.remove('active');
        settingsEl.classList.add('visible'); logEl.classList.remove('visible');
    };

    function renderSettings() {
        settingsEl.innerHTML = `
            <div class="s-group">
                <div class="s-row"><span>Корм (кг):</span><input type="number" id="s-feed" class="s-input" value="${settings.feedAmount}"></div>
                <div class="s-row"><span>Овес (кг):</span><input type="number" id="s-oat" class="s-input" value="${settings.oatAmount}"></div>
                <div class="s-row"><span>Задержка (мс):</span><input type="number" id="s-d-action" class="s-input" value="${settings.delayAction}"></div>
            </div>
            <div class="s-group">
                <div class="s-row" style="margin-bottom:6px"><span>Действия:</span></div>
                <div class="s-check" id="s-checks"></div>
            </div>
        `;

        const checksBox = settingsEl.querySelector('#s-checks');
        const allActions = [...ACTIONS_PRE, { id: 'feed', name: 'Кормить' }, ...ACTIONS_POST, { id: 'next', name: 'Следующая' }];
        
        allActions.forEach(a => {
            const lbl = document.createElement('label');
            lbl.innerHTML = `<input type="checkbox" ${settings.enabled[a.id] ? 'checked' : ''} data-id="${a.id}"> ${a.name}`;
            checksBox.appendChild(lbl);
        });

        settingsEl.querySelector('#s-feed').oninput = e => { settings.feedAmount = parseInt(e.target.value)||0; saveSettings(); };
        settingsEl.querySelector('#s-oat').oninput = e => { settings.oatAmount = parseInt(e.target.value)||0; saveSettings(); };
        settingsEl.querySelector('#s-d-action').oninput = e => { settings.delayAction = parseInt(e.target.value)||1500; saveSettings(); };
        
        settingsEl.querySelectorAll('input[data-id]').forEach(cb => {
            cb.onchange = () => { settings.enabled[cb.dataset.id] = cb.checked; saveSettings(); };
        });
    }
    renderSettings();

    // Перетаскивание
    const hdr = panel.querySelector('#lp-hdr');
    let drag = false, dx = 0, dy = 0;
    hdr.addEventListener('mousedown', e => {
        if (e.target.closest('button')) return;
        drag = true; dx = e.clientX - panel.offsetLeft; dy = e.clientY - panel.offsetTop;
    });
    document.addEventListener('mousemove', e => {
        if (!drag) return;
        panel.style.left = (e.clientX - dx) + 'px'; panel.style.top = (e.clientY - dy) + 'px'; panel.style.right = 'auto';
    });
    document.addEventListener('mouseup', () => { drag = false; });
    panel.querySelector('#lp-min').onclick = () => {
        panel.querySelector('#lp-body').style.display = panel.querySelector('#lp-body').style.display === 'none' ? 'block' : 'none';
    };

    // ================= УТИЛИТЫ =================
    function normalize(t) {
        return String(t || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/\s+/g, ' ').trim().toLowerCase();
    }
    function isVisible(el) {
        if (!el || el.closest('#lp-panel')) return false;
        const r = el.getBoundingClientRect(); return r.width > 1 && r.height > 1;
    }
    
    function findTarget(texts) {
        const kws = texts.map(normalize);
        const els = document.querySelectorAll('a, button, .btn, img, input[type="submit"], td, span');
        for (let el of els) {
            if (!el || !isVisible(el)) continue;
            let clickable = el;
            if (el.tagName === 'IMG') clickable = el.closest('a, button, [onclick]') || el;
            if (clickable.disabled || clickable.classList.contains('disabled')) continue;

            let text = normalize(clickable.textContent + ' ' + (clickable.value || '') + ' ' + (clickable.title || ''));
            if (el.tagName === 'IMG') text += ' ' + normalize(el.alt);
            if (clickable.querySelector('img')) {
                clickable.querySelectorAll('img').forEach(img => text += ' ' + normalize(img.alt));
            }

            for (let kw of kws) {
                if (text.includes(kw)) return clickable;
            }
        }
        return null;
    }

    function fireClick(el) {
        try {
            el.scrollIntoView({ block: 'center' });
            const rect = el.getBoundingClientRect();
            const x = rect.left + rect.width / 2;
            const y = rect.top + rect.height / 2;
            const opts = { bubbles: true, cancelable: true, view: window, clientX: x, clientY: y };
            el.dispatchEvent(new MouseEvent('mousedown', opts));
            el.dispatchEvent(new MouseEvent('mouseup', opts));
            el.dispatchEvent(new MouseEvent('click', opts));
        } catch (e) { el.click(); }
    }

    async function setScalePoint(sectionName, targetValue) {
        const targetStr = String(targetValue);
        const normSection = normalize(sectionName);

        let sliders = Array.from(document.querySelectorAll(`[data-number="${targetStr}"]`)).filter(isVisible);

        if (sliders.length === 0) {
            log(`⚠ Числа ${targetStr} нет на шкале. Ищу ближайшее...`);
            const allPoints = Array.from(document.querySelectorAll('[data-number]')).filter(el => isVisible(el) && !isNaN(parseInt(el.getAttribute('data-number'))));
            if (allPoints.length > 0) {
                allPoints.sort((a, b) => Math.abs(parseInt(a.getAttribute('data-number')) - targetValue) - Math.abs(parseInt(b.getAttribute('data-number')) - targetValue));
                sliders = [allPoints[0]];
            }
        }

        if (sliders.length === 0) return false;

        sliders.sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top);

        if (normSection.includes('корм')) {
            log(`📝 Клик по точке в "${sectionName}" (верхняя)`);
            fireClick(sliders[0]);
            return true;
        } else if (normSection.includes('овес')) {
            const targetEl = sliders[sliders.length - 1];
            log(`📝 Клик по точке в "${sectionName}" (нижняя)`);
            fireClick(targetEl);
            return true;
        }
        return true;
    }

    async function confirmModal() {
        const btns = document.querySelectorAll('a, button, .btn, input[type="submit"]');
        for (let btn of btns) {
            if (!isVisible(btn)) continue;
            const text = normalize(btn.textContent + ' ' + (btn.value || ''));
            const isConfirmText = text === 'подтвердить' || text === 'принять' || text === 'ок' || text === 'да' || 
                                  text === 'почистить' || text === 'дать поесть' || text.includes('состарить');
            const style = window.getComputedStyle(btn);
            const isGreen = style.backgroundColor.includes('139, 195, 74') || style.backgroundColor.includes('76, 175, 80') || style.backgroundColor.includes('46, 125, 50');

            if (isConfirmText || isGreen) {
                log(`🔘 Подтверждаю: "${text.slice(0,15)}"`);
                fireClick(btn);
                await sleep(settings.delayModal);
                return true;
            }
        }
        return false;
    }

    // ================= ЛОГИКА =================
    async function runCycle() {
        if (!isRunning) return;
        
        try {
            log(`=== Новый цикл (${settings.mode === 'train' ? 'Кач' : 'Прогон'}) ===`);
            actionCount = 0;

            // 1. ДЕЙСТВИЯ ДО КОРМЛЕНИЯ
            for (let act of ACTIONS_PRE) {
                if (!isRunning) return;
                if (!settings.enabled[act.id]) continue;
                // В режиме Прогон пропускаем морковь и смесь для скорости
                if (settings.mode === 'run' && ['carrot', 'mash', 'pet'].includes(act.id)) continue;

                const btn = findTarget(act.kw);
                if (btn) {
                    log(`✓ ${act.name}`);
                    fireClick(btn);
                    await sleep(settings.delayAction);
                    await confirmModal();
                    await sleep(500);
                    actionCount++;
                }
            }

            // 2. КОРМЛЕНИЕ
            if (isRunning && settings.enabled.feed) {
                const feedBtn = findTarget(['кормить', 'покормить', 'feed']);
                if (feedBtn) {
                    log('Клик: Кормить');
                    fireClick(feedBtn);
                    await sleep(1500);

                    await setScalePoint('корм', settings.feedAmount);
                    await sleep(500);
                    await setScalePoint('овес', settings.oatAmount);
                    await sleep(500);

                    const giveBtn = findTarget(['дать поесть', 'дать', 'feed']);
                    if (giveBtn) {
                        log('✅ Нажимаю "Дать поесть"');
                        fireClick(giveBtn);
                        await sleep(settings.delayAction);
                    }
                    await confirmModal();
                    actionCount++;
                }
            }

            // 3. ДЕЙСТВИЯ ПОСЛЕ КОРМЛЕНИЯ (Сон, Вырастить, Далее)
            if (settings.mode === 'run') {
                // В режиме прогон ищем кнопку "Далее"
                if (settings.enabled.next) {
                    const nextBtn = findTarget(['следующая', 'далее', 'next', 'suivant', 'вправо']);
                    if (nextBtn) {
                        log('➡ Переход к следующей лошади');
                        fireClick(nextBtn);
                        await sleep(3000); // Ждем загрузки
                    } else {
                        log('⚠ Кнопка "Далее" не найдена.');
                    }
                }
            } else {
                // В режиме Кач делаем пост-действия
                for (let act of ACTIONS_POST) {
                    if (!isRunning) return;
                    if (!settings.enabled[act.id]) continue;

                    const btn = findTarget(act.kw);
                    if (btn) {
                        log(`✓ ${act.name}`);
                        fireClick(btn);
                        await sleep(settings.delayAction);
                        await confirmModal();
                        await sleep(500);
                        actionCount++;
                    }
                }
            }
        } catch (err) {
            log(`⚠ Ошибка: ${err.message}`);
        } finally {
            if (isRunning) {
                log(`Цикл завершен. Ждем...`);
                clearTimeout(loopTimeout);
                loopTimeout = setTimeout(runCycle, settings.loopDelay);
            }
        }
    }

    function updateToggle() {
        toggleBtn.textContent = isRunning ? '■ Стоп' : '▶ Старт';
        toggleBtn.classList.toggle('running', isRunning);
        statusEl.textContent = isRunning ? 'Работает' : 'Готов';
        
        if (isRunning) {
            statusDot.className = 'lp-status-dot running';
        } else {
            statusDot.className = 'lp-status-dot stopped';
        }
        
        modeBtns.forEach(b => b.disabled = isRunning);
        settings.isRunning = isRunning; saveSettings();
    }

    toggleBtn.addEventListener('click', () => {
        if (isRunning) {
            isRunning = false;
            clearTimeout(loopTimeout);
            log('⏹ Остановлено пользователем');
        } else {
            isRunning = true;
            log('▶ Запуск');
            clearTimeout(loopTimeout);
            runCycle();
        }
        updateToggle();
    });

    setInterval(() => {
        if (settings.isRunning && !loopTimeout && !isRunning) {
            isRunning = true;
            updateToggle();
            runCycle();
        }
    }, 5000);

    if (settings.isRunning) {
        log('♻ Продолжаю...');
        isRunning = true;
        updateToggle();
        setTimeout(() => {
            if (isRunning) runCycle();
        }, 2000);
    } else {
        log('v43 готов. Красивый UI и Прогон включен.');
        updateToggle();
    }
})();
