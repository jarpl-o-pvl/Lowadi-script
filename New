/*==================== ПРОВЕРКИ ====================*/
function needWash()   { return $('#module-history .grid-row:contains("Полный уход")').length === 0; }
function needLesson() {
	if ($('#mission').length !== 0) {
		if ((chevalAge > 23) && (+$('#energie').text() - (+$('#mission-wrapper').html().substr($('#mission-wrapper').html().indexOf('Энергия'), 45).replace(/[^,0-9]/gim,'').replace(/[,]/gim,'.')) > 20) && (doLesson == 1)) {
			if ($('#mission').text().indexOf('недостаточно энергии') !== -1) { return false; }
			else if ($('#mission-wrapper a').hasClass('action-disabled')) { return false; }
			else return true;
		} else return false;
	} else return false;
}
function needCare()   { return !(($('#module-history .grid-row:contains("погладили")').length !== 0) || (doCare == 0)); }
function needDrink()  { return !(($('#module-history .grid-row:contains("был(а) напоен")').length !== 0) || (doDrink == 0)); }
function needCarrot() { return !(($('#module-history .grid-row:contains("съел(а) морковь")').length !== 0) || (doCarrot == 0) || ($('#boutonCarotte').hasClass('action-disabled'))); }
function needMash() {
	if ((chevalAge > 23) && (doMash == 1)) {
		return !(($('#module-history .grid-row:contains("съел(а) комбикорм")').length !== 0) || ($('#boutonMash').hasClass('action-disabled')));
	} else return false;
}
function needFeed() {
	if (chevalAge < 6) { return $('#module-history .grid-row:contains("молоко матери")').length === 0; }
	else { return !(($('#module-history .grid-row:contains("фураж")').length !== 0) || ($('#messageBoxInline').text().indexOf('толст') !== -1)); }
}
function needSleep() { return !$('#boutonCoucher').hasClass('action-disabled'); }

function getMerch(item) {
	var a = 0;
	var merch = $('#objects-body-content a');
	if (merch.length !== 0) {
		for (var i = 0; i < merch.length; i++) {
			if ((($('#objects-body-content a').eq(i).attr('data-tooltip')) || '').indexOf(item) !== -1) { a = 1; }
		}
	}
	return a !== 0;
}
function getTime() {
	var timeId = $('.hour').text();
	if (!timeId || timeId.length < 5) return 0;
	var hours = +(timeId[0]+timeId[1]);
	var minutes = +(timeId[3]+timeId[4]);
	return hours*60 + minutes;
}
function getCenter() {
	var info = $('.centerLocalisation').attr('class');
	if (info !== undefined) {
		switch(true) {
			case (info.indexOf('Foret') !== -1): return 'Лес';
			case (info.indexOf('Montagne') !== -1): return 'Горы';
			case (info.indexOf('Plage') !== -1): return 'Пляж';
		}
	} else return 'Нет';
}
function beachPercent() {
	var scr = $('#formbaladePlage script:eq(1)').html();
	if (scr !== undefined) {
		var max = +scr.substring(scr.indexOf('"max":-'), scr.indexOf('"max":-')+15).replace(/[^.0-9]/gim,'');
		var min = +scr.substring(scr.indexOf('"value":-'), scr.indexOf('"max":-')).replace(/[^.0-9]/gim,'');
		if ($('#walk-plage-form').text().indexOf('не имеет навыков для перевода') !== -1) { max = 0; min = 1; }
		return Math.round(max/min);
	}
}

/*==================== ПРОВЕРКИ ТРЕНИРОВОК ====================*/
function canPlay(minEnergy) {
	if ((chevalAge > 6) && (chevalAge < 18) && (babyPlay == 1)) {
		var time = getTime(); var workEnergy = +($('#energie').text());
		if (minEnergy == 21) { var limit = 1200; } else if (minEnergy == 20) { var limit = maxtime; }
		var a = 0; while (workEnergy - playEnergy > minEnergy) { workEnergy -= playEnergy; a++; }
		var b = 0; while (time + 30 <= limit) { time += 30; b++; }
		var points = Math.min(a, b);
		if (points > 20) { points = 20; }
		if (minEnergy == 21) {
			return (points !== 0) && (($("img[src$='/media/equideo/image/fonctionnels/20/jeu.png']").length === 0) || ($('#module-history .grid-row:contains("играл")').length === 0));
		} else if (minEnergy == 20) {
			return (points !== 0) && (($("img[src$='/media/equideo/image/fonctionnels/20/jeu.png']").length == 1) || ($('#module-history .grid-row:contains("играл")').length == 1));
		}
	}
	return false;
}
function canWalk(walkOption, minEnergy) {
	if (chevalAge > 18) {
		var time = getTime(); var workEnergy = +($('#energie').text());
		var limit = minEnergy == 21 ? 1200 : maxtime;
		var a = 0; while (workEnergy - walkEnergy > minEnergy) { workEnergy -= walkEnergy; a++; }
		var b = 0; while (time + 30 <= limit) { time += 30; b++; }
		var points = Math.min(a, b);
		if (points > 20) { points = 20; }
		if (walkOption == 'Лес') {
			return (points !== 0) && (($("img[src$='/media/equideo/image/fonctionnels/20/balade-foret.png']").length === 0) || ($('#module-history .grid-row:contains("прогулка в лесу")').length === 0));
		} else if (walkOption == 'Горы') {
			return (points !== 0) && (($("img[src$='/media/equideo/image/fonctionnels/20/balade-montagne.png']").length === 0) || ($('#module-history .grid-row:contains("прогулка в горах")').length === 0));
		}
	}
	return false;
}
function canTrain(trainOption, minEnergy) {
	if (chevalAge > 18) {
		var time = getTime(); var workEnergy = +($('#energie').text());
		var limit = minEnergy == 21 ? 1200 : maxtime;
		var energy = minEnergy == 21 ? goEnergy : (minEnergy == 20 ? runEnergy : vitalEnergy);
		var a = 0; while (workEnergy - energy > minEnergy) { workEnergy -= energy; a++; }
		var b = 0; while (time + 30 <= limit) { time += 30; b++; }
		var points = Math.min(a, b);
		if (points > 20) { points = 20; }
		if (trainOption && ($('#module-history .grid-row:contains("'+trainOption+'")').length === 0)) {
			return (points !== 0);
		}
	}
	return false;
}
function finishWalk(walkOption) {
	return (walkOption == 'Лес') || (walkOption == 'Горы');
}

/*==================== ТРЕНИРОВКА / ВЫГУЛ ====================*/
function doTrainings() {
	// Игра (жеребята)
	if (canPlay(21)) {
		var playBtn = $("button:has(img[src$='/media/equideo/image/fonctionnels/20/jeu.png'])");
		if (playBtn.length) { playBtn[0].click(); return true; }
	}
	// Выгул / тренировки (взрослые)
	if (chevalAge > 18) {
		var actions = {
			'Лес':      $("button:has(img[src$='/media/equideo/image/fonctionnels/20/balade-foret.png'])"),
			'Горы':     $("button:has(img[src$='/media/equideo/image/fonctionnels/20/balade-montagne.png'])"),
			'Пляж':     $("button:has(img[src$='/media/equideo/image/fonctionnels/20/balade-plage.png'])")
		};
		var order = [walkOption1, walkOption2, trainOption1, trainOption2, trainOption3,
		             trainOption4, trainOption5, trainOption6, train2Option1, train2Option2,
		             train2Option3, train2Option4, train2Option5, train2Option6];
		for (var i = 0; i < order.length; i++) {
			var opt = order[i];
			if (!opt) continue;
			if (actions[opt] && actions[opt].length) {
				if (canWalk(opt, 20) || canWalk(opt, 21)) { actions[opt][0].click(); return true; }
			} else {
				var btn = $("button:contains('" + opt + "')");
				if (btn.length && !btn.hasClass('action-disabled') && (canTrain(opt, 20) || canTrain(opt, 21))) {
					btn[0].click(); return true;
				}
			}
		}
	}
	return false;
}

/*==================== УХОД НА СТРАНИЦЕ ЛОШАДИ ====================*/
function careCycle() {
	if (location.href.indexOf('chevaux/cheval?id') === -1) { return false; }
	// 1. Сон
	if (needSleep() && (chevalAge > 4)) {
		sleep(); return true;
	}
	// 2. Кормление
	if (needFeed()) {
		feed(); return true;
	}
	// 3. Морковь
	if (needCarrot()) { carrot(); return true; }
	// 4. Комбикорм
	if (needMash()) { mash(); return true; }
	// 5. Вода
	if (needDrink()) { drink(); return true; }
	// 6. Чистка/уход
	if (needWash()) { wash(); return true; }
	// 7. Ласка
	if (needCare()) { care(); return true; }
	// 8. Урок
	if (needLesson()) { lesson(); return true; }
	// 9. Тренировки
	if (doTrainings()) { return true; }
	// 10. Взросление (жеребята до 3 лет)
	if ((chevalAge < 3) && (chevalAge > 0)) {
		grow(); return true;
	}
	return false;
}

/*==================== СЛУЧКА / РАЗВЕДЕНИЕ ====================*/
function breedingCycle() {
	if ((location.href.indexOf('chevaux/cheval?id') !== -1) && (chevalSexe == 'F') && (chevalAge > 3) && (chevalAge < 20)) {
		if (breedButton === 0) {
			var btn = $('button:contains("Случить")');
			if (btn.length && !btn.hasClass('action-disabled')) { btn[0].click(); breedButton = 1; return true; }
		}
	}
	if (location.href.indexOf('chevaux/saillie?id') !== -1) {
		if (sluchButton === 0) {
			$('#race12').val(kob);
			$('#race12').change();
			var go = $('button:contains("Искать")');
			if (go.length) { go[0].click(); sluchButton = 1; return true; }
		} else {
			var item = $('#saillieContent .highlight:eq(0) button:contains("Случить")');
			if (item.length && !item.hasClass('action-disabled')) { item[0].click(); return true; }
			clearNulls();
		}
	}
	return false;
}

/*==================== ПРОДАЖА / АМУНИЦИЯ ====================*/
function sellCycle() {
	if ((location.href.indexOf('chevaux/cheval?id') !== -1) && selle) {
		if (selle == 2) {
			var place_btn = $('button:contains("Выставить на продажу")');
