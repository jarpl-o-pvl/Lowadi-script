}

/*==================== ОСНОВНОЙ ЦИКЛ (КАЧЕР) ====================*/
function mainLoop() {
	if (pauseQPower == 'true') { setTimeout(mainLoop, 2000); return; }
	clearNulls();
	patchConfirm();
	startCenterWatcher();

	// Центр
	if (location.href.indexOf('chevaux/centreInscription') !== -1) {
		kskWrite();
	}
	// Страница лошади
	else if (location.href.indexOf('chevaux/cheval?id') !== -1) {
		initHorseParams();
		kskWrite();
		if (!careCycle()) {
			breedingCycle();
			sellCycle();
			// Автообновление, если ничего не сделано
			if (reloadButton === 0) {
				reloadButton = 1;
				setTimeout(function() { location.reload(); }, 1500);
			}
		}
	}
	// Остальные страницы — просто обновляемся
	else if (reloadButton === 0) {
		reloadButton = 1;
		setTimeout(function() { location.reload(); }, pause);
	}

	setTimeout(mainLoop, pause);
}

