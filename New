							&& ($('#boxContent .highlight').eq(i).find('.align-center span[data-tooltip^="В этом стойле есть автопоилка"]').length !== 0)
							&& ($('#boxContent .highlight .centerLocalisation').eq(i).hasClass(pl))
							&& ($('#boxContent .highlight:eq('+i+') button:eq('+duree+')').hasClass('disabled') == false)) {
							if (kskButton === 0) { $('#boxContent .highlight:eq('+i+') button:eq('+duree+')').click(); kskButton = 1; break; }
						}
					}
				}
				break;
