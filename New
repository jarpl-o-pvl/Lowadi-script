								&& ($('#boxContent .highlight:eq('+i+') button:eq('+duree2+')').hasClass('disabled') == false)) {
								if (kskButton === 0) { $('#boxContent .highlight:eq('+i+') button:eq('+duree2+')').click(); kskButton = 1; break; }
